        <mxCell id="fbg" value="fbg-server&#xa;assigns each MATCH a bgio URL&#xa;(MatchUtil.getBgioServerUrl)&#xa;→ all players of a match get&#xa;the SAME url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="nginx Ingress&#xa;/socket.io/&#xa;cookie affinity (sticky)&#xa;keeps the socket.io v4&#xa;long-poll→WS upgrade&#xa;on the SAME pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontStyle=1;" vertex="1" parent="1">
