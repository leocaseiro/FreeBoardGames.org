          <mxGeometry x="600" y="120" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="roomA" value="socket.io room = match A&#xa;reducer(A) → broadcast to A only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pod1">
          <mxGeometry x="30" y="50" width="320" height="60" as="geometry" />
