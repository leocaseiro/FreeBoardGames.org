          <mxGeometry x="360" y="20" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Players / Browsers&#xa;(1 tab = up to 4 connections)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="150" height="90" as="geometry" />
