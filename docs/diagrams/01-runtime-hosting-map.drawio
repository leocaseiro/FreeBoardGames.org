          <mxGeometry x="250" y="180" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cluster" value="Kubernetes cluster — DigitalOcean SFO3 (kubectl context: do-sfo3-fbg-k8s2), deployed via Helm" style="swimlane;rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4a86e8;fontStyle=1;startSize=40;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="900" height="700" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="nginx Ingress + cert-manager&#xa;TLS (Let's Encrypt)&#xa;cookie affinity = socket.io stickiness&#xa;force-ssl-redirect, CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontStyle=1;" vertex="1" parent="cluster">
          <mxGeometry x="30" y="70" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="websvc" value="Service: fbg-web&#xa;ClusterIP :80 → :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cluster">
          <mxGeometry x="320" y="70" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fbgsrvsvc" value="Service: fbg-server&#xa;ClusterIP :80 → :3001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cluster">
          <mxGeometry x="320" y="190" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bgiosvc" value="Service: fbg-bgio&#xa;ClusterIP :80 → :8001&#xa;sessionAffinity: None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cluster">
          <mxGeometry x="320" y="310" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="webdep" value="Deployment: fbg-web&#xa;Next.js + Express SSR&#xa;SERVER_TYPE=WEB :3000&#xa;serves / , /docs, static&#xa;replicas.web (default 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster">
          <mxGeometry x="560" y="55" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fbgsrvdep" value="Deployment: fbg-server&#xa;NestJS GraphQL API&#xa;HTTP + WS subscriptions&#xa;assigns match → bgio pod&#xa;replicas.fbgServer (default 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster">
          <mxGeometry x="560" y="190" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bgiodep" value="Deployment: fbg-bgio&#xa;boardgame.io + socket.io&#xa;SERVER_TYPE=BGIO :8001&#xa;same image as web&#xa;replicas.bgio (default 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster">
          <mxGeometry x="560" y="325" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="Bitnami PostgreSQL&#xa;lobby: user/room/match&#xa;+ boardgame.io game state&#xa;(single instance — SPOF)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="cluster">
          <mxGeometry x="320" y="470" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="Bitnami Redis (standalone — SPOF)&#xa;PUB/SUB ONLY — not a queue:&#xa;• GraphQL subs (fbg-server)&#xa;• boardgame.io redis-pubsub (bgio)&#xa;NOT a socket.io adapter" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="cluster">
          <mxGeometry x="560" y="470" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="CronJob: fbg-backuper&#xa;daily 12:00 UTC&#xa;pg_dump + per-table CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadcf8;strokeColor=#9673a6;" vertex="1" parent="cluster">
          <mxGeometry x="30" y="470" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gcs" value="Google Cloud Storage&#xa;gs://fbg-database-dump" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4285F4;strokeColor=#4285F4;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1430" y="620" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="v2 static site (experimental — NOT prod backend)&#xa;GitHub Pages: v2.freeboardgames.org&#xa;next export from v2/fbg-web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="860" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cicd" value="CI / Deploy&#xa;CI (GitHub Actions): minikube + helm + Playwright e2e on every PR&#xa;Prod deploy (NOT CI): systemd timer → fbg-autoupdate → helm upgrade&#xa;+ docker build/push (Docker Hub) + kubectl rollout restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="scaling" value="Scaling model&#xa;1. Stateless app tiers → bump replicas.web / fbgServer / bgio&#xa;2. Ingress cookie affinity keeps a socket.io client on one bgio pod&#xa;3. fbg-server pins each MATCH to one bgio pod (per-match sharding)&#xa;4. Shared Postgres state + Redis pub/sub relay coordinate pods&#xa;⚠️ Defaults: replicas=1, no HPA/PDB/limits; Postgres+Redis are SPOF/bottleneck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="850" width="540" height="160" as="geometry" />
        </mxCell>
